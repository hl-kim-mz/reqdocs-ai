# NextAuth
NEXTAUTH_URL=http://localhost:4100
NEXTAUTH_SECRET=replace-with-`openssl rand -base64 32`

# Google Workspace SSO
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 회사 도메인. Google Workspace의 Hosted Domain (hd) 파라미터로 강제.
ALLOWED_HD=example.com

# 도메인 (P3에서 활성화)
APP_DOMAIN=docs.example.com
CONTENT_DOMAIN=content.example.com

# DB (개발은 SQLite, 운영은 PostgreSQL)
DATABASE_URL="file:./dev.db"

# 로컬 스토리지 경로 (dev). 운영에서는 S3/Supabase 키로 대체.
LOCAL_STORAGE_DIR=./storage

# 제한
MAX_UPLOAD_SIZE_MB=10
